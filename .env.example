# Copy to .env and fill in.
OLLAMA_URL=http://localhost:11434
# Local default is gemma4:e4b. For Ollama cloud: gemma4:31b-cloud
OLLAMA_MODEL=gemma4:e4b
SENTRY_DSN=
TEMPORAL_ADDRESS=localhost:7233
NTFY_TOPIC=
# Log file the breadcrumb tails for the last terminal error. Empty = ~/.duckwalk/terminal.log (written by `dw`)
DUCKWALK_TERMINAL_LOG=
# Comma-separated repos the daemon counts commits in
DUCKWALK_REPOS=
# P(stuck) above this triggers a nudge
DUCKWALK_STUCK_THRESHOLD=0.7
# 1 = the daemon starts a walk session when P(stuck) crosses the threshold (needs a trained detector)
DUCKWALK_AUTO_NUDGE=0
# Prior Labs API key, needed once to download TabPFN weights (https://ux.priorlabs.ai)
TABPFN_TOKEN=
# Voice loop: TTS engine is "piper" (offline, default) or "elevenlabs" (opt-in, sends the duck's replies to ElevenLabs)
DUCKWALK_TTS=piper
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional audio devices (sounddevice name or index); empty = system default
DUCKWALK_AUDIO_IN=
DUCKWALK_AUDIO_OUT=
# The duck's LLM: ollama (default) | llamacpp (tuned model served locally, offline) | tinker (tuned model, cloud)
DUCK_BACKEND=ollama
DUCK_MODEL=
LLAMACPP_URL=http://127.0.0.1:8081
