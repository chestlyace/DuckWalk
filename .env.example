# Copy to .env and fill in.
OLLAMA_URL=http://localhost:11434
# Local default is gemma4:e4b. For Ollama cloud: gemma4:31b-cloud
OLLAMA_MODEL=gemma4:e4b
SENTRY_DSN=
TEMPORAL_ADDRESS=localhost:7233
NTFY_TOPIC=
# Log file the breadcrumb tails for the last terminal error (e.g. `pytest 2>&1 | tee ~/.duckwalk/terminal.log`)
DUCKWALK_TERMINAL_LOG=
